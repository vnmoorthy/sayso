# ── Sayso server configuration ─────────────────────────────────────────────────
# Copy to .env and fill in what you have. Anything missing falls back gracefully:
# no LLM key → local demo brain, no Hume key → browser speech, no STT key → local Whisper.

# LLM (pick one; SambaNova is the hackathon default)
SAMBANOVA_API_KEY=
SAYSO_MODEL=Meta-Llama-3.3-70B-Instruct      # DeepSeek-V3.1 | gpt-oss-120b | MiniMax-M2.7 …
# GENERAL_COMPUTE_API_KEY=                    # uses https://api.generalcompute.com/v1 + gemma-4-31B-it
# OPENAI_API_KEY=
# SAYSO_LLM_PROVIDER=sambanova                # force: sambanova | general_compute | openai | local | demo
# LOCAL_LLM_URL=http://127.0.0.1:8081/v1      # local OpenAI-compatible server, e.g. `uv run python -m mlx_lm.server --model mlx-community/Qwen2.5-7B-Instruct-4bit --port 8081`

# Voice + emotion (Hume Octave TTS + expression measurement)
HUME_API_KEY=
# HUME_VOICE_ID=                              # optional; otherwise resolved from HUME_VOICE_NAME
HUME_VOICE_NAME=Ava Song
# SAYSO_EMOTION=1                             # set 0 to disable prosody scoring
# SAYSO_TTS_PROVIDER=kokoro                   # force: hume | kokoro (local neural voice, no key) | browser
# KOKORO_VOICE=af_heart                       # af_bella af_nicole af_sky am_adam am_michael bf_emma bm_george …

# Speech-to-text (pick one; otherwise local Whisper runs on your machine)
GRADIUM_API_KEY=                              # coupon HACKATHON-202609 at gradium.ai
# DEEPGRAM_API_KEY=
# SAYSO_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo-q4

# Actions
SAYSO_GITHUB_REPO=vnmoorthy/sayso             # where voice-filed issues go (gh CLI must be logged in)
# SAYSO_WORKSPACE=../workspace                # sandbox directory the agent works in
# SAYSO_OPEN_SYSTEM_BROWSER=0                 # 1 = also open URLs in your real browser
# SAYSO_SHELL_TIMEOUT=90
# SAYSO_FAKE_EMOTION=0                        # 1 = simulate emotion from loudness when no Hume key (UI testing)
